
# ==========================================
# FraudShield AI - .gitignore
# ==========================================

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/

# Ambientes virtuais
.venv/
venv/
env/

# Variáveis de ambiente e segredos
.env
.env.*
!.env.example

# Jupyter Notebook
.ipynb_checkpoints/

# Datasets
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Modelos e artefatos de Machine Learning
artifacts/
models/
mlruns/
mlartifacts/

# MLflow - banco e artefatos persistentes
/mlflow.db
/mlflow.db-shm
/mlflow.db-wal
/mlflow-artifacts/
/mlflow/artifacts/

# Bancos SQLite locais
*.sqlite
*.sqlite3

# Next.js / Node.js
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testes e cobertura do frontend
coverage/
playwright-report/
test-results/

# IDEs e editores
.vscode/
.idea/
*.swp
*.swo

# Arquivos temporários
*.tmp
*.temp
*.bak

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini
